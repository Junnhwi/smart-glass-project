# .env.example (이건 GitHub에 올려도 됨)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=kr-standard
STORAGE_ENDPOINT_URL=https://kr.object.ncloudstorage.com
STORAGE_ADDRESSING_STYLE=path
# readiness probe mode: config | deep
INFERENCE_STORAGE_READINESS_MODE=config
API_CAPTURE_ENABLE_RAG_INDEX=0
# 선택 사항. explicit VISION_CAPTION_* env가 없을 때만 사용됨
# INFERENCE_SERVING_PROFILE_PATH=apps/inference-server/benchmark_results/caption_serving_profile.json
HF_TOKEN=
VISION_QWEN_FALLBACK_MODEL=qwen2.5-vl-3b
VISION_QWEN_ENABLE_OBJECT_REVIEW=1
# 선택 사항. 7B OOM이 날 때만 조정
# VISION_QWEN_MAX_IMAGE_PIXELS=1048576

# LLM (local dev uses Ollama via docker compose)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SEC=20

# docker-compose.yml과 .env.example이 GitHub에 올려져있는 상태.

# 팀원은 프로젝트를 git pull 받은 뒤, .env.example을 복사해 자신의 .env 파일을 만듭니다.

# 팀원도 각자의 Object Storage 계정 키나 공유받은 키를 .env에 입력하고 바로 실행합니다.
