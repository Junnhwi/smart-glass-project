# .env.example (이건 GitHub에 올려도 됨)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2

# LLM (local dev uses Ollama via docker compose)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SEC=20

# docker-compose.yml과 .env.example이 GitHub에 올려져있는 상태.

# 팀원은 프로젝트를 git pull 받은 뒤, .env.example을 복사해 자신의 .env 파일을 만듭니다.

# 팀원도 각자의 AWS 계정 키나 공유받은 키를 .env에 입력하고 바로 실행합니다.
